# ============================================================
# PORTFOLIO — REQUIRED ENVIRONMENT VARIABLES
# Copy these keys into Vercel Dashboard > Project > Settings > Environment Variables
# ============================================================

# MongoDB Atlas connection string (include /portfolio as the database name)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=

# Strong random secret for JWT signing (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Admin credentials (used for seeding the admin user — keep secret)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# GitHub API — create a token at https://github.com/settings/tokens (read:user, public_repo scopes)
GITHUB_USERNAME=
GITHUB_TOKEN=

# Google Gemini AI — get key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Your production URL (set AFTER your first Vercel deployment)
# Example: https://yourportfolio.vercel.app  OR  https://yourdomain.com
NEXT_PUBLIC_APP_URL=
